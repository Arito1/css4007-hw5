# Copy to .env. Part 1 and all tests do not need a model or API key.
# This project uses Anthropic Claude through langchain-anthropic.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default); claude-sonnet-5-5 or claude-haiku-5-5 are cheaper alternatives.
MODEL_NAME=claude-opus-5-5
# Reasoning effort sent as output_config.effort: low | medium | high | xhigh | max
HELPDESK_EFFORT=medium
# 1 = enable the server-side refusal fallback (Opus 5.x / Sonnet 5.5 only); 0 = off.
HELPDESK_REFUSAL_FALLBACK=1
# Default model for `chat` and `scenarios`: anthropic (real) or fake (offline rules).
HELPDESK_MODEL=anthropic
# Use your own paths; keep persistent data out of git.
HELPDESK_STORAGE_DIR=local-storage
# Keep external tracing disabled for this local exercise.
LANGSMITH_TRACING=false
